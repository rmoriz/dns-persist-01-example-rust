# The DNS names to obtain a certificate for.
#
# On the first run this example prints a `_validation-persist` TXT record for
# these names. You must publish that record manually, then press Enter.
#
# List the apex name and its `*.` wildcard together to get both on one
# certificate. The validation record always stays at the base domain, so
# "example.com" and "*.example.com" share the same record. See the
# "Wildcard certificates" section of the README.
domains = ["example.com", "*.example.com"]

# Requested certificate lifetime in days. Google Trust Services accepts 1 to 90
# and recommends at least 3. The running server renews in place, so short
# lifetimes need no restart.
certificate_days = 7

# Renew once less than this many days of lifetime remain. Must be above 0 and
# below certificate_days; fractions are allowed.
renew_before_days = 3

# How often the running server checks the lifetime, in seconds.
renew_check_interval_secs = 3600

# After issuing, print still-valid certificates for these names from
# Certificate Transparency (Cert Spotter, crt.sh as fallback).
ct_lookup = true

# Contact URI sent when the ACME account is created. Change this.
contact = "mailto:admin@example.com"

# Address the HTTPS server listens on after the certificate is issued.
bind = "0.0.0.0:8443"

# Directory for the ACME account and the issued certificate/key.
state_dir = "./state"

# Serve HTTPS after issuing. Set to false when only the certificate files are
# wanted; the process still stays up and renews.
serve = true

# Optional program run after every successful issuance, with the new files
# already written. Beware: the state directory is its working directory.
#renew_hook = "/usr/local/bin/reload-proxy"

[ca]
# Google Trust Services production ACME directory.
directory_url = "https://dv.acme-v02.api.pki.goog/directory"

# Google's Issuer Domain Name, as documented for dns-persist-01.
# See https://developers.google.com/public-key-infrastructure/updates/september2026-dns-persist-01
issuer_domain_name = "pki.goog"

# TTL for the TXT record printed on the first run.
ttl = 3600

# Google Trust Services requires External Account Binding. Create these in the
# GTS console and paste them here.
eab_kid = "REPLACE_WITH_EAB_KID"
eab_hmac_key = "REPLACE_WITH_BASE64URL_HMAC_KEY"

# Also authorize subdomains via policy=wildcard (safe for a single-name order).
policy_wildcard = true

# Optional custom root CA PEM for testing against a private ACME server (Pebble).
# root_certificate = "ca.pem"
